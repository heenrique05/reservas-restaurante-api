# Porta da API (se ficar vazio, usa 3001)
PORT=3001

# Endereços que podem chamar a API, separados por vírgula
# Ex.: o front em React rodando no Vite
CORS_ORIGINS=http://localhost:5173

# Banco PostgreSQL (pegue no painel do Neon, botão Connect)
# Com pooler: usado pela API
DATABASE_URL_POOLED=
# Sem pooler: usado pelas migrations
DATABASE_URL=

# Segredo que assina os tokens de login. Use um texto longo e aleatório.
# Para gerar um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Quanto tempo o login vale (ex.: 1h, 1d, 7d)
JWT_EXPIRACAO=1d

# Opcional: banco SÓ para os testes de integração. Ele é apagado a cada teste.
# Nunca coloque aqui o mesmo banco da DATABASE_URL.
DATABASE_URL_TESTE=
