{
  "name": "reservas-api",
  "version": "1.0.0",
  "description": "API de reservas de restaurante com mesas, lista de espera e sinal por Pix",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "tsx src/database/migrar.ts",
    "db:rollback": "tsx src/database/migrar.ts rollback",
    "db:migrate:prod": "node dist/database/migrar.js"
  },
  "keywords": [
    "api",
    "reservas",
    "restaurante",
    "express",
    "typescript"
  ],
  "author": "Henrique",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
